+func TestSSNUDPSessionLimit(t *testing.T) {
+	accepted := make(chan net.Conn, 2)
+	u := newUdpConnectionHandler(func(c net.Conn, _ net.Destination) { accepted <- c }, nil)
+	u.maxConns = 1
+	dst := net.UDPDestination(net.ParseAddress("1.1.1.1"), 443)
+	first := net.UDPDestination(net.ParseAddress("10.0.0.1"), 1234)
+	other := net.UDPDestination(net.ParseAddress("10.0.0.1"), 1235)
+	u.HandlePacket(first, dst, buf.New())
+	conn := <-accepted
+	u.HandlePacket(other, dst, buf.New())
+	if len(u.udpConns) != 1 || u.udpConns[other] != nil {
+		t.Fatal("an extra UDP session was admitted")
+	}
+	u.HandlePacket(first, dst, buf.New())
+	for i := 0; i < 2; i++ {
+		mb, err := conn.(buf.Reader).ReadMultiBuffer()
+		if err != nil {
+			t.Fatal(err)
+		}
+		buf.ReleaseMulti(mb)
+	}
+	conn.Close()
+	u.HandlePacket(other, dst, buf.New())
+	conn = <-accepted
+	mb, _ := conn.(buf.Reader).ReadMultiBuffer()
+	buf.ReleaseMulti(mb)
+	conn.Close()
+}
