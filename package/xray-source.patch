+// ssnHotspot receives the already detected Windows Mobile Hotspot adapter and
+// its IPv4 address/prefix from the desktop supervisor.
+func ssnHotspot() (*uint64, netip.Addr, netip.Prefix, error) {
+	value := os.Getenv("SSN_HOTSPOT")
+	if value == "" {
+		return nil, netip.Addr{}, netip.Prefix{}, nil
+	}
+	luidText, cidr, ok := strings.Cut(value, ",")
+	luid, luidErr := strconv.ParseUint(luidText, 10, 64)
+	prefix, prefixErr := netip.ParsePrefix(cidr)
+	if !ok || luidErr != nil || luid == 0 || prefixErr != nil || !prefix.Addr().Is4() || !prefix.Addr().IsPrivate() || prefix.Bits() < 16 || prefix.Bits() > 30 {
+		return nil, netip.Addr{}, netip.Prefix{}, errors.New("invalid SSN_HOTSPOT adapter")
+	}
+	return &luid, prefix.Addr(), prefix.Masked(), nil
+}
