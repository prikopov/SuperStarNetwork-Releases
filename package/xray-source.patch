+// ssnFlowLimit reads the desktop supervisor's per-process settings.
+func ssnFlowLimit(name string) (int, error) {
+	value := os.Getenv(name)
+	if value == "" {
+		return 0, nil
+	}
+	n, err := strconv.Atoi(value)
+	if err != nil || n < 0 || n > 4096 {
+		return 0, errors.New("invalid ", name, ": expected 0..4096")
+	}
+	return n, nil
+}
